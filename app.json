{
  "configVersion": "v3",
  "app": {
    "appId": 30001,
    "appName": "Digital",
    "appType": "watchface",
    "version": {
      "code": 1,
      "name": "1.0.0"
    },
    "icon": "icon.png",
    "vender": "zepp",
    "description": "Digital watch face for Amazfit Balance 2"
  },
  "permissions": [
    "data:user.hd.heart_rate",
    "data:user.hd.step",
    "data:user.hd.pai",
    "data:weather"
  ],
  "runtime": {
    "apiVersion": {
      "compatible": "3.0.0",
      "target": "3.0.0",
      "minVersion": "3.0.0"
    }
  },
  "targets": {
    "480x480-amazfit-balance-2": {
      "module": {
        "watchface": {
          "path": "watchface/index",
          "main": 1,
          "editable": 0,
          "lockscreen": 1
        }
      },
      "platforms": [
        { "deviceSource": 9568512 },
        { "deviceSource": 9568513 },
        { "deviceSource": 9568515 }
      ],
      "designWidth": 480
    }
  },
  "i18n": {
    "en-US": {
      "appName": "Digital"
    }
  },
  "defaultLanguage": "en-US",
  "debug": true
}
